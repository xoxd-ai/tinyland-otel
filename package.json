{
  "name": "@tummycrypt/tinyland-otel",
  "version": "1.1.0",
  "private": true,
  "description": "OpenTelemetry instrumentation layer: tracer factory, span helpers, TraceQL query builder, RED metrics, Tempo query service, Loki-backed analytics data, and file-based observability logging",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./analytics-data": {
      "types": "./dist/analytics-data/index.d.ts",
      "import": "./dist/analytics-data/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "check:package": "publint"
  },
  "keywords": [
    "opentelemetry",
    "tracing",
    "observability",
    "tempo",
    "traceql",
    "red-metrics",
    "spans",
    "instrumentation",
    "grafana",
    "loki",
    "analytics"
  ],
  "author": "Tinyland.dev",
  "license": "Zlib AND LicenseRef-Tinyland-Proprietary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoxd-ai/tinyland-otel.git"
  },
  "dependencies": {},
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@pyroscope/nodejs": "^0.6.5",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "5.0.3",
    "publint": "^0.3.25",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": ">=0.67.0 <1.0.0",
    "@opentelemetry/sdk-node": ">=0.209.0 <1.0.0",
    "@pyroscope/nodejs": ">=0.4.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/auto-instrumentations-node": {
      "optional": true
    },
    "@opentelemetry/sdk-node": {
      "optional": true
    },
    "@pyroscope/nodejs": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "packageManager": "pnpm@10.13.1",
  "homepage": "https://github.com/xoxd-ai/tinyland-otel",
  "bugs": {
    "url": "https://github.com/xoxd-ai/tinyland-otel/issues"
  }
}
